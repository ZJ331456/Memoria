{
  "servers": [
    {
      "name": "search",
      "command": [
        ".venv/Scripts/python.exe",
        "scripts/mcp_server.py",
        "search"
      ],
      "enabled": true,
      "risk": "read-only",
      "allowed_tools": [
        "search",
        "fetchWebContent"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "github",
      "command": [
        ".venv/Scripts/python.exe",
        "scripts/mcp_server.py",
        "github"
      ],
      "enabled": true,
      "risk": "read-only",
      "allowed_tools": [
        "get_me",
        "get_file_contents",
        "search_repositories",
        "search_code",
        "list_branches",
        "list_commits",
        "issue_read",
        "pull_request_read"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "feishu",
      "command": [
        ".venv/Scripts/python.exe",
        "scripts/mcp_server.py",
        "feishu"
      ],
      "enabled": false,
      "risk": "read-only",
      "timeout_seconds": 60,
      "allowed_tools": [
        "docx_v1_document_rawContent",
        "drive_v1_file_list",
        "wiki_v2_space_list",
        "wiki_v2_space_getNode"
      ]
    }
  ]
}